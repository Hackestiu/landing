# Copy to .env on the server and fill in. .env is gitignored — never commit it.

# Domain the demo is served from. Must already point at this server (A record)
# before the first `docker compose up`, or Caddy cannot get a certificate.
DEMO_DOMAIN=demo.culturaviva.tech

# Read token with access to culturaviva/park_guell-vit and
# culturaviva/sagrada_familia-vit. Both repos are private; without this the app
# still boots but every photo comes back unclassified.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
