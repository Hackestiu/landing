---
import Layout from '../layouts/Layout.astro';
import TrencadisRow from '../components/TrencadisRow.astro';
import CatenaryDivider from '../components/CatenaryDivider.astro';
import KnowledgeGraphDemo from '../components/KnowledgeGraphDemo.astro';

const pipeline = [
  {
    n: '01',
    title: 'Fes una foto',
    titleEn: 'Take a photo',
    detail: 'Apunta amb la càmera cap a l’element de Gaudí que vulguis conèixer.',
    detailEn: 'Point the camera at the Gaudí element you want to learn about.',
    example: 'Apuntes cap al Drac del Parc Güell.',
    exampleEn: 'You point at the Dragon of Park Güell.',
    tone: 'blue',
  },
  {
    n: '02',
    title: 'Fes una pregunta',
    titleEn: 'Ask a question',
    detail: 'Parla-hi com si tinguessis un guia al costat',
    detailEn: 'Talk to it like you would a guide at your side',
    example: '«De què està fet aquest trencadís?»',
    exampleEn: '“What is this mosaic made of?”',
    tone: 'green',
  },
  {
    n: '03',
    title: 'Rep la resposta',
    titleEn: 'Get the answer',
    detail: 'Cultura Viva respon a l’instant, en veu, feta a mida per a aquell racó de Gaudí.',
    detailEn: 'Cultura Viva replies instantly, by voice, tailored to that corner of Gaudí.',
    example: '«Del trencadís, fet amb rajoles de ceràmica trencades i reaprofitades.»',
    exampleEn: '“It’s trencadís, made from broken, reused ceramic tiles.”',
    tone: 'ochre',
  },
];

// Live demo running the board's own pipeline — the container in space/, on
// Fly.io (see space/DEPLOY.md). Fly serves it over HTTPS on <app>.fly.dev with
// no DNS setup; swap this for https://demo.culturaviva.tech after running
// `fly certs add` and adding the record Fly prints to Netlify DNS.
const DEMO_URL = 'https://cultura-viva-demo.fly.dev';

const toneMap = {
  blue: { bg: 'bg-blue-soft', text: 'text-blue-deep', chip: 'bg-blue' },
  green: { bg: 'bg-green-soft', text: 'text-green-deep', chip: 'bg-green' },
  ochre: { bg: 'bg-ochre-soft', text: 'text-ochre-deep', chip: 'bg-ochre' },
};
---
<Layout
  title="Cultura Viva — El patrimoni que parla"
  description="Cultura Viva converteix les audioguies estàtiques del patrimoni català en una conversa real, amb IA local, sense núvol, per a l'Any Gaudí 2026."
>
  <header class="fixed top-0 inset-x-0 z-40 bg-paper/85 backdrop-blur-sm border-b border-ink/5">
    <nav class="max-w-6xl mx-auto flex items-center justify-between px-6 py-4" aria-label="Navegació principal">
      <a href="#top" class="font-display font-semibold text-lg tracking-tight text-ink">
        Cultura <span class="text-blue">Viva</span>
      </a>
      <div class="flex items-center gap-8">
        <ul class="hidden md:flex items-center gap-8 font-mono text-xs uppercase tracking-widest2 text-ink/70">
          <li><a href="#funcionament" data-en="How it works" class="hover:text-blue transition-colors">Funcionament</a></li>
          <li><a href="#demo" data-en="Video" class="hover:text-blue transition-colors">Vídeo</a></li>
          <li><a href="#prova" data-en="Try it" class="hover:text-blue transition-colors">Prova-ho</a></li>
          <li><a href="#graf" data-en="Knowledge graph" class="hover:text-blue transition-colors">Graf</a></li>
          <li><a href="#impacte" data-en="Impact" class="hover:text-blue transition-colors">Impacte</a></li>
        </ul>
        <div
          class="flex items-center p-0.5 rounded-full border border-ink/10 bg-ink/[0.03] font-mono text-[11px] uppercase tracking-widest2"
          role="group"
          aria-label="Selector d'idioma / Language selector"
        >
          <button type="button" data-lang-btn data-lang="ca" class="px-2.5 py-1 rounded-full transition-colors">CA</button>
          <button type="button" data-lang-btn data-lang="en" class="px-2.5 py-1 rounded-full transition-colors">EN</button>
        </div>
      </div>
    </nav>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="relative pt-40 pb-28 px-6 overflow-hidden">
      <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 w-[420px] h-[420px] rounded-full bg-blue-soft blur-3xl opacity-70"></div>
      <div aria-hidden="true" class="pointer-events-none absolute top-40 -left-32 w-[320px] h-[320px] rounded-full bg-ochre-soft blur-3xl opacity-60"></div>

      <div class="relative max-w-4xl mx-auto text-center">
        <p class="eyebrow mb-6" data-en="Gaudí Year 2026">Any Gaudí 2026</p>
        <h1
          class="text-5xl md:text-7xl leading-[1.05] text-ink mb-6"
          data-en-html={`Live <span class="text-blue">Culture</span>`}
        >
          Cultura <span class="text-blue">Viva</span>
        </h1>
        <p class="text-xl md:text-2xl text-ink/80 mb-8" data-en="Heritage that speaks">
          El patrimoni que parla
        </p>
        <p
          class="max-w-xl mx-auto text-lg text-ink/70 mb-10 leading-relaxed"
          data-en="Cultura Viva turns the static audio guide into a real conversation with the heritage of Antoni Gaudí."
        >
          Cultura Viva transforma l'audioguia estàtica en una conversa real amb el patrimoni
          d'Antoni Gaudí.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href="#funcionament"
            data-en="Discover the project"
            class="inline-flex items-center justify-center rounded-full bg-ink text-paper px-8 py-4 font-medium hover:bg-blue-deep transition-colors"
          >
            Descobreix el projecte
          </a>
        </div>
        <TrencadisRow class="justify-center mt-14" />
      </div>
    </section>

    <CatenaryDivider />

    <!-- FUNCIONAMENT -->
    <section id="funcionament" class="px-6 py-24 max-w-6xl mx-auto">
      <div class="max-w-2xl mb-16">
        <p class="eyebrow mb-4" data-en="How it works">Com funciona</p>
        <h2 class="text-3xl md:text-4xl text-ink mb-5" data-en="Point, ask, listen">Apunta, pregunta, escolta</h2>
      </div>

      <ol class="grid sm:grid-cols-3 gap-6 items-start" aria-label="Passos per fer servir Cultura Viva">
        {pipeline.map((step) => {
          const t = toneMap[step.tone];
          return (
            <li
              class={`step-card rounded-2xl p-6 ${t.bg} border border-ink/5 cursor-pointer select-none`}
              data-step-card
              tabindex="0"
              role="button"
              aria-expanded="false"
            >
              <div class="flex items-center gap-3 mb-4">
                <span class={`w-8 h-8 rounded-full ${t.chip} text-paper text-xs font-mono flex items-center justify-center`}>
                  {step.n}
                </span>
                <h3 class={`font-display text-lg ${t.text}`} data-en={step.titleEn}>{step.title}</h3>
              </div>
              <p class="text-sm text-ink/70 leading-relaxed" data-en={step.detailEn}>{step.detail}</p>
              <div class="step-example">
                <div>
                  <p class="mt-4 pt-4 border-t border-ink/10 text-sm italic text-ink/80" data-en={step.exampleEn}>
                    {step.example}
                  </p>
                </div>
              </div>
            </li>
          );
        })}
      </ol>
      <p class="mt-6 text-center font-mono text-xs text-ink/40" data-en="Hover or tap a step to see it in action">
        Passa el ratolí o toca un pas per veure'l en acció
      </p>
    </section>

    <style>
      .step-card {
        transition: transform 300ms ease;
      }
      .step-card:hover,
      .step-card.is-open {
        transform: scale(1.04);
      }
      .step-example {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 300ms ease;
      }
      .step-card:hover .step-example,
      .step-card.is-open .step-example {
        grid-template-rows: 1fr;
      }
      .step-example > div {
        overflow: hidden;
      }
    </style>

    <script>
      document.querySelectorAll<HTMLElement>('[data-step-card]').forEach((card) => {
        function toggle() {
          const willOpen = !card.classList.contains('is-open');
          document.querySelectorAll<HTMLElement>('[data-step-card].is-open').forEach((c) => {
            c.classList.remove('is-open');
            c.setAttribute('aria-expanded', 'false');
          });
          if (willOpen) {
            card.classList.add('is-open');
            card.setAttribute('aria-expanded', 'true');
          }
        }
        card.addEventListener('click', toggle);
        card.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            toggle();
          }
        });
      });
    </script>

    <CatenaryDivider flip />

    <!-- DEMO -->
    <section id="demo" class="px-6 py-24 max-w-5xl mx-auto">
      <div class="max-w-2xl mb-10">
        <p class="eyebrow mb-4" data-en="Video">Vídeo</p>
        <h2 class="text-3xl md:text-4xl text-ink" data-en="Cultura Viva in action">Cultura Viva en acció</h2>
      </div>
      <div class="relative aspect-video rounded-2xl bg-ink flex items-center justify-center overflow-hidden">
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.06]">
          <TrencadisRow class="scale-[8] origin-top-left" />
        </div>
        <div class="relative flex flex-col items-center gap-4">
          <div class="w-16 h-16 rounded-full bg-paper/10 border border-paper/20 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="w-6 h-6 text-paper/70 translate-x-0.5">
              <path d="M8 5v14l11-7-11-7z" fill="currentColor" />
            </svg>
          </div>
          <p class="font-mono text-xs uppercase tracking-widest2 text-paper/60" data-en="Coming soon">Properament</p>
        </div>
      </div>
    </section>

    <CatenaryDivider flip />

    <!-- PROVA-HO -->
    <section id="prova" class="px-6 py-24 max-w-5xl mx-auto">
      <div class="max-w-2xl mb-10">
        <p class="eyebrow mb-4" data-en="Try it">Prova-ho</p>
        <h2 class="text-3xl md:text-4xl text-ink" data-en="The same pipeline, in your browser">El mateix pipeline, al teu navegador</h2>
        <p class="mt-4 text-ink/70 leading-relaxed" data-en="Vision, speech, language and synthesis: the four models the device runs offline, here exactly as they are. Upload a photo of a Gaudí element, ask it a question, and listen to the answer.">
          Visió, veu, llenguatge i síntesi: els quatre models que el dispositiu
          executa sense connexió, aquí tal com són. Puja una foto d'un element
          de Gaudí, fes-li una pregunta i escolta la resposta.
        </p>
      </div>

      <div
        id="prova-frame"
        class="relative rounded-2xl border border-ink/10 bg-ink/[0.02] overflow-hidden"
        data-demo-url={DEMO_URL}
      >
        <div class="aspect-[4/3] md:aspect-[16/10] flex items-center justify-center px-6">
          <div class="text-center max-w-md">
            <p class="font-display text-xl text-ink mb-3" data-en="Wake the demo">Desperta la demo</p>
            <p class="text-sm text-ink/60 leading-relaxed mb-6" data-en="It runs on a free CPU server and sleeps when idle, so the first load takes about a minute while the models are read back into memory.">
              S'executa en un servidor de CPU gratuït i s'adorm quan no s'usa,
              així que la primera càrrega triga aproximadament un minut mentre
              els models es tornen a carregar a memòria.
            </p>
            <button
              type="button"
              id="prova-load"
              class="inline-flex items-center gap-2 rounded-full bg-ink text-paper px-5 py-2.5 font-mono text-xs uppercase tracking-widest2 hover:bg-blue-deep transition-colors"
              data-en="Load the demo"
            >
              Carrega la demo
            </button>
          </div>
        </div>
      </div>

      <p class="mt-5 text-xs text-ink/50 leading-relaxed max-w-2xl" data-en="The browser stands in for the camera, the microphone, the GPS and the buttons; everything else is the device's own code. Note that this server is faster than the board's four Cortex-A53 cores, so it shows that the pipeline works, not how fast it runs on the hardware.">
        El navegador fa de càmera, micròfon, GPS i botons; la resta és el codi
        del dispositiu. Tingues en compte que aquest servidor és més ràpid que
        els quatre nuclis Cortex-A53 de la placa: la demo demostra que el
        pipeline funciona, no a quina velocitat corre sobre el maquinari.
      </p>
    </section>

    <CatenaryDivider />

    <!-- GRAF DE CONEIXEMENT -->
    <section id="graf" class="px-6 py-24 max-w-5xl mx-auto">
      <div class="max-w-2xl mb-10 mx-auto text-center">
        <p class="eyebrow mb-4" data-en="Knowledge graph">Graf de coneixement</p>
        <h2 class="text-3xl md:text-4xl text-ink" data-en="Gaudí's work in a graph">L'obra de Gaudí en un graf</h2>
        <p class="mt-4 text-ink/70 leading-relaxed" data-en="The language model consults a graph of entities and relations about Gaudí's work so every answer stays grounded and verifiable.">
          El model de llenguatge consulta un graf d'entitats i relacions
          sobre l'obra de Gaudí perquè cada resposta sigui fonamentada i verificable.
        </p>
      </div>
      <KnowledgeGraphDemo theme="light" />
    </section>

    <CatenaryDivider />

    <!-- IMPACTE -->
    <section id="impacte" class="px-6 py-28 bg-ink text-paper relative overflow-hidden">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.06]">
        <TrencadisRow class="scale-[6] origin-top-left" />
      </div>
      <div class="relative max-w-5xl mx-auto">
        <p class="eyebrow text-ochre mb-4" data-en="Impact">Impacte</p>
        <h2 class="text-3xl md:text-4xl mb-14 max-w-2xl" data-en="AI within everyone's reach">
          IA a l'abast de tothom
        </h2>
        <div class="grid sm:grid-cols-3 gap-8">
          <div class="border-t border-paper/20 pt-6">
            <div class="w-10 h-10 rounded-full bg-paper/10 flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="w-5 h-5 text-paper/80">
                <rect x="7" y="7" width="10" height="10" rx="1.5" stroke-width="1.6" />
                <path
                  d="M9 3v3M12 3v3M15 3v3M9 18v3M12 18v3M15 18v3M3 9h3M3 12h3M3 15h3M18 9h3M18 12h3M18 15h3"
                  stroke-width="1.4"
                  stroke-linecap="round"
                />
              </svg>
            </div>
            <h3 class="font-display text-xl mb-2" data-en="On-device">Local</h3>
            <p
              class="text-sm text-paper/60 leading-relaxed"
              data-en="All the AI lives on the device: no cloud, no costly connections."
            >
              Tota la intel·ligència artificial viu al dispositiu: sense núvol, sense connexions
              costoses.
            </p>
          </div>
          <div class="border-t border-paper/20 pt-6">
            <div class="w-10 h-10 rounded-full bg-paper/10 flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="w-5 h-5 text-paper/80">
                <path d="M4 10v4M9 6v12M14 8v8M19 11v2" stroke-width="1.8" stroke-linecap="round" />
              </svg>
            </div>
            <h3 class="font-display text-xl mb-2" data-en="Inclusive">Inclusiu</h3>
            <p class="text-sm text-paper/60 leading-relaxed" data-en="Voice-first, so it reaches people with visual impairments too.">
              Pensat per a la veu, també arriba a persones amb dificultats visuals.
            </p>
          </div>
          <div class="border-t border-paper/20 pt-6">
            <div class="w-10 h-10 rounded-full bg-paper/10 flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="w-5 h-5 text-paper/80">
                <path d="M11 3H4v7l9 9 7-7-9-9Z" stroke-width="1.6" stroke-linejoin="round" />
                <circle cx="7.5" cy="7.5" r="1" fill="currentColor" stroke="none" />
              </svg>
            </div>
            <h3 class="font-display text-xl mb-2" data-en="Affordable">Assequible</h3>
            <p class="text-sm text-paper/60 leading-relaxed" data-en="Low-cost hardware, easy to replicate in any museum.">
              Maquinari de baix cost, fàcil de replicar a qualsevol museu.
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <footer class="px-6 py-12 border-t border-ink/10">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <TrencadisRow />
        <span class="font-display text-ink/80" data-en="Cultura Viva — Heritage that speaks">Cultura Viva — El patrimoni que parla</span>
      </div>
      <p class="text-xs text-ink/40 font-mono text-center md:text-right">
        2026
      </p>
    </div>
  </footer>
</Layout>

<script>
  const LANG_KEY = 'cv-lang';

  function applyLang(lang) {
    document.documentElement.lang = lang === 'en' ? 'en' : 'ca';

    document.querySelectorAll('[data-en]').forEach((el) => {
      if (!el.dataset.ca) el.dataset.ca = el.textContent ?? '';
      el.textContent = lang === 'en' ? el.dataset.en ?? '' : el.dataset.ca;
    });

    document.querySelectorAll('[data-en-html]').forEach((el) => {
      if (!el.dataset.caHtml) el.dataset.caHtml = el.innerHTML;
      el.innerHTML = lang === 'en' ? el.dataset.enHtml ?? '' : el.dataset.caHtml;
    });

    document.querySelectorAll('[data-lang-btn]').forEach((btn) => {
      const active = btn.dataset.lang === lang;
      btn.classList.toggle('bg-ink', active);
      btn.classList.toggle('text-paper', active);
      btn.classList.toggle('text-ink/50', !active);
    });
  }

  const stored = localStorage.getItem(LANG_KEY) || 'ca';
  applyLang(stored);

  document.querySelectorAll('[data-lang-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.dataset.lang;
      localStorage.setItem(LANG_KEY, lang);
      applyLang(lang);
    });
  });

  // The Space sleeps when idle and takes a while to wake, so it is only
  // embedded on demand: no visitor pays for it just by scrolling past.
  const provaFrame = document.getElementById('prova-frame');
  const provaButton = document.getElementById('prova-load');

  provaButton?.addEventListener('click', () => {
    const url = provaFrame?.dataset.demoUrl;
    if (!url || !provaFrame) return;

    const iframe = document.createElement('iframe');
    iframe.src = url;
    iframe.title = 'Cultura Viva — demo';
    iframe.className = 'w-full h-[80vh] min-h-[640px] border-0';
    iframe.allow = 'camera; microphone; autoplay; clipboard-write';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';

    provaFrame.replaceChildren(iframe);
  });
</script>
