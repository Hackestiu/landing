---
import Layout from '../layouts/Layout.astro';
import TrencadisRow from '../components/TrencadisRow.astro';
import CatenaryDivider from '../components/CatenaryDivider.astro';

const pipeline = [
  {
    n: '01',
    title: 'Fes una foto',
    detail: 'Apunta amb la càmera cap a l’element de Gaudí que vulguis conèixer.',
    tone: 'blue',
  },
  {
    n: '02',
    title: 'Fes una pregunta',
    detail: 'Parla-hi com si tinguessis un guia al costat: «De què està fet?»',
    tone: 'green',
  },
  {
    n: '03',
    title: 'Rep la resposta',
    detail: 'Cultura Viva respon a l’instant, en veu, feta a mida per a aquell racó de Gaudí.',
    tone: 'ochre',
  },
];

const toneMap = {
  blue: { bg: 'bg-blue-soft', text: 'text-blue-deep', chip: 'bg-blue' },
  green: { bg: 'bg-green-soft', text: 'text-green-deep', chip: 'bg-green' },
  ochre: { bg: 'bg-ochre-soft', text: 'text-ochre-deep', chip: 'bg-ochre' },
};
---
<Layout
  title="Cultura Viva — El patrimoni que parla"
  description="Cultura Viva converteix les audioguies estàtiques del patrimoni català en una conversa real, amb IA local, sense núvol, per a l'Any Gaudí 2026."
>
  <header class="fixed top-0 inset-x-0 z-40 bg-paper/85 backdrop-blur-sm border-b border-ink/5">
    <nav class="max-w-6xl mx-auto flex items-center justify-between px-6 py-4" aria-label="Navegació principal">
      <a href="#top" class="font-display font-semibold text-lg tracking-tight text-ink">
        Cultura <span class="text-blue">Viva</span>
      </a>
      <ul class="hidden md:flex items-center gap-8 font-mono text-xs uppercase tracking-widest2 text-ink/70">
        <li><a href="#funcionament" class="hover:text-blue transition-colors">Funcionament</a></li>
        <li><a href="#demo" class="hover:text-blue transition-colors">Demo</a></li>
        <li><a href="#impacte" class="hover:text-blue transition-colors">Impacte</a></li>
      </ul>
    </nav>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="relative pt-40 pb-28 px-6 overflow-hidden">
      <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 w-[420px] h-[420px] rounded-full bg-blue-soft blur-3xl opacity-70"></div>
      <div aria-hidden="true" class="pointer-events-none absolute top-40 -left-32 w-[320px] h-[320px] rounded-full bg-ochre-soft blur-3xl opacity-60"></div>

      <div class="relative max-w-4xl mx-auto text-center">
        <p class="eyebrow mb-6">Any Gaudí 2026</p>
        <h1 class="text-5xl md:text-7xl leading-[1.05] text-ink mb-6">
          El patrimoni<br class="hidden md:block" /> que <em class="not-italic text-blue">parla</em>
        </h1>
        <p class="max-w-xl mx-auto text-lg text-ink/70 mb-10 leading-relaxed">
          Cultura Viva transforma l'audioguia estàtica en una conversa real amb el patrimoni
          d'Antoni Gaudí. Tota la intel·ligència artificial viu al dispositiu: sense núvol,
          sense connexions costoses, a l'abast de qualsevol museu.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href="#funcionament"
            class="inline-flex items-center justify-center rounded-full bg-ink text-paper px-8 py-4 font-medium hover:bg-blue-deep transition-colors"
          >
            Descobreix el projecte
          </a>
        </div>
        <TrencadisRow class="justify-center mt-14" />
      </div>
    </section>

    <CatenaryDivider />

    <!-- FUNCIONAMENT -->
    <section id="funcionament" class="px-6 py-24 max-w-6xl mx-auto">
      <div class="max-w-2xl mb-16">
        <p class="eyebrow mb-4">Com funciona</p>
        <h2 class="text-3xl md:text-4xl text-ink mb-5">Apunta, pregunta, escolta</h2>
      </div>

      <ol class="grid sm:grid-cols-3 gap-6" aria-label="Passos per fer servir Cultura Viva">
        {pipeline.map((step) => {
          const t = toneMap[step.tone];
          return (
            <li class={`rounded-2xl p-6 ${t.bg} border border-ink/5`}>
              <div class="flex items-center gap-3 mb-4">
                <span class={`w-8 h-8 rounded-full ${t.chip} text-paper text-xs font-mono flex items-center justify-center`}>
                  {step.n}
                </span>
                <h3 class={`font-display text-lg ${t.text}`}>{step.title}</h3>
              </div>
              <p class="text-sm text-ink/70 leading-relaxed">{step.detail}</p>
            </li>
          );
        })}
      </ol>
    </section>

    <CatenaryDivider flip />

    <!-- DEMO -->
    <section id="demo" class="px-6 py-24 max-w-5xl mx-auto">
      <div class="max-w-2xl mb-10">
        <p class="eyebrow mb-4">Demo</p>
        <h2 class="text-3xl md:text-4xl text-ink">Cultura Viva en acció</h2>
      </div>
      <div class="relative aspect-video rounded-2xl bg-ink flex items-center justify-center overflow-hidden">
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.06]">
          <TrencadisRow class="scale-[8] origin-top-left" />
        </div>
        <div class="relative flex flex-col items-center gap-4">
          <div class="w-16 h-16 rounded-full bg-paper/10 border border-paper/20 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="w-6 h-6 text-paper/70 translate-x-0.5">
              <path d="M8 5v14l11-7-11-7z" fill="currentColor" />
            </svg>
          </div>
          <p class="font-mono text-xs uppercase tracking-widest2 text-paper/60">Properament</p>
        </div>
      </div>
    </section>

    <CatenaryDivider />

    <!-- IMPACTE -->
    <section id="impacte" class="px-6 py-28 bg-ink text-paper relative overflow-hidden">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.06]">
        <TrencadisRow class="scale-[6] origin-top-left" />
      </div>
      <div class="relative max-w-5xl mx-auto">
        <p class="eyebrow text-ochre mb-4">Impacte i democratització de la IA</p>
        <h2 class="text-3xl md:text-4xl mb-6 max-w-2xl">
          La IA no necessita grans infraestructures per ser útil el dia a dia
        </h2>
        <p class="text-paper/70 max-w-2xl leading-relaxed mb-14">
          En traslladar la inferència directament a maquinari de baix cost, Cultura Viva es
          converteix en una eina de divulgació de la identitat i la cultura catalanes a l'abast
          de qualsevol espai patrimonial.
        </p>
        <div class="grid sm:grid-cols-3 gap-8">
          <div class="border-t border-paper/20 pt-6">
            <h3 class="font-display text-xl mb-2">Portàtil</h3>
            <p class="text-sm text-paper/60 leading-relaxed">
              Un dispositiu autònom, alimentat amb powerbank, pensat per moure's per l'exterior
              amb l'usuari.
            </p>
          </div>
          <div class="border-t border-paper/20 pt-6">
            <h3 class="font-display text-xl mb-2">Inclusiu</h3>
            <p class="text-sm text-paper/60 leading-relaxed">
              L'àudio interactiu obre el patrimoni a persones amb dificultats visuals, sense
              dependre de pantalles.
            </p>
          </div>
          <div class="border-t border-paper/20 pt-6">
            <h3 class="font-display text-xl mb-2">Assequible</h3>
            <p class="text-sm text-paper/60 leading-relaxed">
              Fàcilment replicable per museus i espais culturals locals amb pressupostos
              reduïts.
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <footer class="px-6 py-12 border-t border-ink/10">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <TrencadisRow />
        <span class="font-display text-ink/80">Cultura Viva — El patrimoni que parla</span>
      </div>
      <p class="text-xs text-ink/40 font-mono text-center md:text-right">
        2026
      </p>
    </div>
  </footer>
</Layout>
